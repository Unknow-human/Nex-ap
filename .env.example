# Supabase Configuration Example
# Copy this file to .env.local and fill in your Supabase credentials
# DO NOT commit .env.local to version control

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# App Version
EXPO_PUBLIC_APP_VERSION=1.0.0

# EAS Project
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id

# Connexion Google (facultatif) — active le bouton "Continuer avec Google"
# sur l'écran de connexion. Nécessite :
#  1. Des identifiants OAuth créés sur https://console.cloud.google.com
#     (un par plateforme : Web, Android, iOS).
#  2. Le provider Google activé côté Supabase (Dashboard > Authentication
#     > Providers > Google), avec le Web Client ID ci-dessous renseigné
#     là-bas aussi.
# Sans ces variables, le bouton Google reste simplement masqué.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
