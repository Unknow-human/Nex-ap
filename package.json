{
  "name": "nexus-arena",
  "version": "1.0.0",
  "description": "NEXUS ARENA - Application interactive avec jeu, chat et enregistrements",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:webapp": "expo export --platform web",
    "build": "eas build",
    "eject": "expo eject",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand --detectOpenHandles",
    "prepare:production": "node ./scripts/prepare-production.js",
    "postinstall": "node ./scripts/create-libs-toml.js || true; patch-package",
    "bump:patch": "node ./scripts/bump-version.js patch",
    "bump:minor": "node ./scripts/bump-version.js minor",
    "bump:major": "node ./scripts/bump-version.js major",
    "release": "npm run bump:patch && git add . && git commit -m 'chore: bump version' && npx eas build --platform android --profile production && npx eas update --channel production",
    "build:web": "npm ci --prefix landing-page/web && npm run build --prefix landing-page/web && npm run export --prefix landing-page/web",
    "sync:web-to-landing": "node ./landing-page/scripts/sync-web-to-landing.js",
    "build:landing-with-web": "npm run build:web && npm run sync:web-to-landing"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.45.4",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.7",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-web-browser": "~15.0.11",
    "expo-file-system": "~19.0.4",
    "expo-image-picker": "~17.0.0",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.12",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.11",
    "gh": "^2.8.9",
    "lucide-react-native": "^1.27.0",
    "marked": "^0.6.3",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.1",
    "react-native-webview": "13.16.0",
    "tailwindcss": "^3.3.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "babel-preset-expo": "^54.0.0",
    "eslint": "^8.52.0",
    "eslint-config-expo": "^7.1.1",
    "jest": "^29.3.1",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.2"
  },
  "private": true
}
