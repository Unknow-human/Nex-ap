# ============================================================================
# NEXUS ARENA - Environment Variables Configuration
# ============================================================================
# DO NOT COMMIT THIS FILE (.env files are in .gitignore)
# Copy this to .env.local for local development
# ============================================================================

# SUPABASE CONFIGURATION
# Get these values from Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# APP CONFIGURATION
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_EAS_PROJECT_ID=c468572d-7f75-4781-975f-dd87f9605710

# ENVIRONMENT
NODE_ENV=development

# ============================================================================
# INSTRUCTIONS D'UTILISATION:
# ============================================================================
# 1. Allez sur: https://supabase.com/dashboard
# 2. Sélectionnez votre projet NEXUS ARENA (ou créez-en un nouveau)
# 3. Project Settings > API
# 4. Copiez "Project URL" -> EXPO_PUBLIC_SUPABASE_URL
# 5. Copiez "anon public" key -> EXPO_PUBLIC_SUPABASE_ANON_KEY
# 6. Exécutez supabase/schema.sql dans l'éditeur SQL du projet pour créer
#    les tables, RLS et fonctions RPC
# 7. Activez l'authentification anonyme : Authentication > Providers >
#    Anonymous Sign-Ins > Enable
# 8. Créez le bucket de stockage "audio-messages" (Storage > New bucket,
#    public en lecture) pour les messages vocaux
# ============================================================================
